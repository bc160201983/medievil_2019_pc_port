<!-- MediEvil (CUSA11227) patches for this port (shadPS4 XML format; addresses are PS4
     virtual addresses, eboot base 0x400000). Checked against eboot.bin sha256
     a7e976d13b9649c5cd1ccb617b02f4a27b95c45b9f5331470b90a1f014c3b828 (01.00) and
     e50c9b36153416949d377ad0ddafac1a888c119987095615dc0f69b5ad15e401 (01.02), see
     scripts/patches.py. The 01.02 addresses were located by matching the instructions around
     each 01.00 site; all of them are byte-identical apart from call displacements. -->
<Patch>
    <TitleID>
        <ID>CUSA11227</ID>
        <ID>CUSA12982</ID>
    </TitleID>
    <!-- The PS4 memory manager (0x8f4a00) gives framebuffers a 128 MB pool at 0x4000000000 with
         a power-of-two buddy allocator over 64 KB pages, backed by 128 MB of direct memory
         mapped at start. A 3840x2160 target (33.6 MB) takes a 64 MB block, so r.SetRes
         3840x2160 (the debug menu) ran out of framebuffer memory and crashed. This makes the
         pool 512 MB: buddy pages 0x800 -> 0x2000, its capacity, the direct memory allocation,
         its mapping and the manager's accounting. -->
    <Metadata Title="MediEvil"
              Name="Native 4K framebuffer pool (512 MB)"
              Note="Lets the game draw at 3840x2160 (debug menu: Cinematic Mode). Requires setting DMEM to 512 MB."
              Author="medievil_pc"
              PatchVer="1.0"
              AppVer="01.00"
              AppElf="eboot.bin"
              isEnabled="true">
        <PatchList>
            <!-- mov esi, 0x800 -> 0x2000 (buddy allocator pages) -->
            <Line Type="bytes" Address="0x00cf4c01" Value="00200000"/>
            <!-- mov qword [rbx+0x1d0], 0x800 -> 0x2000 -->
            <Line Type="bytes" Address="0x00cf4c0c" Value="00200000"/>
            <!-- sceKernelAllocateMainDirectMemory size 0x8000000 -> 0x20000000 -->
            <Line Type="bytes" Address="0x00cf4d0a" Value="00000020"/>
            <!-- sceKernelMapDirectMemory size 0x8000000 -> 0x20000000 -->
            <Line Type="bytes" Address="0x00cf4d32" Value="00000020"/>
            <!-- direct memory accounting: mov eax / add rax, 0x8000000 -> 0x20000000 -->
            <Line Type="bytes" Address="0x00cf4d51" Value="00000020"/>
            <Line Type="bytes" Address="0x00cf4d61" Value="00000020"/>
            <!-- pool capacity (base 0x4000000000, size 0x8000000 -> 0x20000000) -->
            <Line Type="bytes" Address="0x04088218" Value="0000002000000000"/>
            <!-- The two free paths (0x8e0f90, 0x8e1c20) find an address's pool from its value:
                 framebuffer when addr >> 27 == 0x800 (the first 128 MB), else Flexible. A 4K target
                 above 128 MB was freed as Flexible (negative page index, crash on the next
                 resolution change). addr >> 29 == 0x200 covers the 512 MB pool. -->
            <Line Type="bytes" Address="0x00ce0fe3" Value="1d"/>
            <Line Type="bytes" Address="0x00ce0fe7" Value="00020000"/>
            <Line Type="bytes" Address="0x00ce1c82" Value="1d"/>
            <Line Type="bytes" Address="0x00ce1c85" Value="00020000"/>
        </PatchList>
    </Metadata>
    <!-- UE4's PS4 display metrics (0xb68fd0, and the work area at 0xb6d640) are computed once and
         cached: 1920x1080 unless r.PS4Allow4kOutput (int at 0x5b1d1d8, read-only, 0 by default) is
         set, then 3840x2160 when VideoOut reports a display taller than 1080. Only the game's
         PS4_Neo_4k device profile sets it. A live r.SetRes to 4K later left these at 1080p, and the
         menus' gamepad navigation stopped at the old 1080p area. This takes the 4K branch whatever
         the cvar says; run.py selects it with a 3840x2160 VideoOut (GOW3_UE4_BOOT_4K=1). -->
    <Metadata Title="MediEvil"
              Name="4K display metrics at boot"
              Note="Starts the game at 3840x2160 with a 4K VideoOut (render resolution 4K native). Requires the Native 4K framebuffer pool."
              Author="medievil_pc"
              PatchVer="1.0"
              AppVer="01.00"
              AppElf="eboot.bin"
              isEnabled="false">
        <PatchList>
            <!-- je past the 4K query when r.PS4Allow4kOutput == 0 -> nop nop (display metrics) -->
            <Line Type="bytes" Address="0x00f69032" Value="9090"/>
            <!-- same in the work area function -->
            <Line Type="bytes" Address="0x00f6d696" Value="9090"/>
        </PatchList>
    </Metadata>
    <!-- UE4's display metrics and work area start from a default rect {0,0,1920,1080} in rodata
         (0x3cbe750 and 0x3cbe7b0), each read only by its own function, and are cached once at boot.
         Writing W and H there boots the game at WxH: window, viewport, backbuffers and UI geometry
         (research/docs/study-boot-resolution.md). Do not combine with "4K display metrics at boot"
         while VideoOut reports more than 1080 lines (its 3840x2160 constant wins). -->
    <Metadata Title="MediEvil"
              Name="Boot display size"
              Note="Starts the game at the output resolution (display metrics and work area); no live r.SetRes. run.py selects it as &quot;Boot display size WxH&quot;: each Type=&quot;size&quot; line writes W and H (two little-endian int32). Requires the Native 4K framebuffer pool above 1080p."
              Author="medievil_pc"
              PatchVer="1.0"
              AppVer="01.00"
              AppElf="eboot.bin"
              isEnabled="false">
        <PatchList>
            <!-- display metrics default rect (rodata 0x3cbe750): Right, Bottom -->
            <Line Type="size" Address="0x040be758" Value="1920x1080"/>
            <!-- work area default rect (rodata 0x3cbe7b0): Right, Bottom -->
            <Line Type="size" Address="0x040be7b8" Value="1920x1080"/>
        </PatchList>
    </Metadata>
    <!-- UE4's GPU sprite emitters have no particle positions on the CPU: without a fixed bounding
         box in the asset, UpdateBoundingBox (0x23828b0) gives them a bogus box of origin -1 / +1,
         so the whole system is culled once its origin leaves the view, even with its particles on
         screen (the same on a PS4). 8 of the game's 180 GPU particle systems have no fixed box,
         among them Dan's crypt's floating dust (PS_air_sparkles: a 400-unit sphere and a vector
         field). The two loads of the -1.0 / 1.0 constants read -2000.0 / 2000.0 from the
         constant pool instead: a 40 m box; the artists' boxes for similar ambient effects are
         +/-10000 (research/docs/plan-0102.md, T-0102-5). -->
    <Metadata Title="MediEvil"
              Name="GPU particle bounds"
              Note="Particle effects such as floating dust no longer vanish when the camera turns a little: GPU particle systems without bounds get a 40 m box instead of a 2-unit one."
              Author="medievil_pc"
              PatchVer="1.0"
              AppVer="01.00"
              AppElf="eboot.bin"
              isEnabled="true">
        <PatchList>
            <!-- vmovss xmm2, [rip -> 0x3e245ec (-1.0)] -> [rip -> 0x3d28fc0 (-2000.0)] -->
            <Line Type="bytes" Address="0x027828e1" Value="db669a01"/>
            <!-- vmovss xmm6, [rip -> 0x3e245f0 (1.0)] -> [rip -> 0x3d298c0 (2000.0)] -->
            <Line Type="bytes" Address="0x027828e9" Value="d36f9a01"/>
        </PatchList>
    </Metadata>
    <!-- UE 4.21's BuildHZB (0x1535740) sizes the HZB's mip 0 as 2^(ceil(log2 W) - 1) by
         2^(ceil(log2 H) - 1) of the view and stretches the whole view over it: 512x256 for a
         858x482 scene (1280x720 at 67%), 1024x512 at 1280x720. A coarser pyramid hides fewer
         objects (Deck: ~63 against ~122 a frame). Dropping the two "- 1" gives mip 0 at least the
         depth's size (1024x512 at 67% of 720p); the occlusion test reads the pyramid's size from
         the view, so it stays consistent (research/docs/study-ue4-draw-reduction.md section 4).
         At 4K it would make a 4096x4096 pyramid for nothing: off by default, for low render
         resolutions. run.py: GOW3_HZB_FULL_SIZE=1 / 0 switches it on / off (extra-env.txt).
         Original: the bytes each line replaces; patches.py skips the patch if they differ. -->
    <Metadata Title="MediEvil"
              Name="Finer occlusion culling (low render resolutions, Steam Deck)"
              Note="Unreal Engine 4 tests which objects are hidden against a depth pyramid half the size of the 3D scene. This builds it at the scene's full size: more hidden objects are skipped at low render resolutions (about 120-145 fewer draws a frame expected in heavy areas at 67% of 720p). For the Steam Deck and other CPU-limited PCs; not useful at 1080p and above."
              Author="medievil_pc"
              PatchVer="1.0"
              AppVer="01.00"
              AppElf="eboot.bin"
              isEnabled="false">
        <PatchList>
            <!-- width: dec r14d -> nop dword [rax] (after vcvttss2si r14d, ceil(log2 W)) -->
            <Line Type="bytes" Address="0x019357ba" Value="0f1f00" Original="41ffce"/>
            <!-- height: dec eax -> xchg ax, ax (after vcvttss2si eax, ceil(log2 H)) -->
            <Line Type="bytes" Address="0x01935812" Value="6690" Original="ffc8"/>
        </PatchList>
    </Metadata>
